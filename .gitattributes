# Force LF for everything text, in the repository and on checkout, on every platform and
# regardless of a contributor's own core.autocrlf. Shell scripts and systemd units are shipped
# to Linux hosts and executed there directly (`sh packaging/install.sh`, maintainer scripts run
# by dpkg); a CRLF line ending turns "set -eu" into a parse error on real Linux shells, and a
# CRLF shebang makes the kernel look for an interpreter that doesn't exist. This project is
# developed on Windows, so this is not a hypothetical.
* text=auto eol=lf

*.sh    text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.service text eol=lf
*.conf  text eol=lf

# Debian maintainer scripts have no extension.
/packaging/debian/postinst text eol=lf
/packaging/debian/postrm   text eol=lf
/packaging/debian/prerm    text eol=lf
