# These files are executed by Debian and systemd, which reject CR. A Windows checkout with
# core.autocrlf=true would otherwise produce a .deb whose maintainer scripts fail to run, and
# the failure would only appear on the target host.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf
packaging/debian/postinst  text eol=lf
packaging/debian/postrm    text eol=lf
packaging/debian/prerm     text eol=lf
