[Unit]
Description=secretbae secret management daemon
Documentation=https://github.com/ajuujain99/secretbae
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/secretbaed

# Starts as root to read /etc/secretbae/master.key (mode 0400 root:root) and acquire
# CAP_IPC_LOCK for mlock'ing the master key into memory. Once the key is unsealed,
# the process permanently drops to the unprivileged secretbae user and group in-process.
User=root
Group=root

# The minimal set the privileged startup sequence actually needs. Every entry below is
# exercised by packaging/tests/capability-matrix.sh, which fails the build if the daemon can
# start without one -- an over-broad bounding set is as much a defect as a too-narrow one.
#
# - CAP_SETUID/SETGID: the permanent drop from root to secretbae:secretbae.
# - CAP_CHOWN:        hand the socket and store to secretbae before dropping.
# - CAP_DAC_OVERRIDE: open /var/lib/secretbae (0700 secretbae:secretbae) while still root.
#                     Root's usual permission-check bypass IS this capability -- without it
#                     the kernel refuses the open regardless of uid 0.
# - CAP_FOWNER:       chmod the store and socket, which after the first run are owned by
#                     secretbae rather than by root.
#
# CAP_IPC_LOCK is deliberately absent: mlockall() needs it only to exceed RLIMIT_MEMLOCK, and
# LimitMEMLOCK below raises that limit to a measured bound instead -- which it must anyway, for
# the reason given there. Granting the capability would fix startup and leave every later
# allocation capped, which is the worse failure of the two.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER

# Ensure child processes cannot acquire additional privileges
NoNewPrivileges=yes

# Strict read-only filesystem mount for all system paths except designated state and runtime directories
ProtectSystem=strict
ReadWritePaths=/var/lib/secretbae /run/secretbae

# Filesystem sandboxing
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes

# Restrict namespace creation and manipulation
RestrictNamespaces=yes

# Restrict scheduling and personality modification
RestrictRealtime=yes
LockPersonality=yes

# Prevent writable and executable memory mappings (W^X violation defense)
MemoryDenyWriteExecute=yes

# Allow standard system service system calls, reject dangerous and unnecessary calls
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Core dump prevention.
#
# Why this matters specifically for secretbae: the daemon holds the unsealed master key in
# memory. An unconstrained core dump after a crash would write that key in plaintext to
# unencrypted disk (/var/lib/systemd/coredump/), bypassing every filesystem ACL and the mlock
# guarantee alike.
LimitCORE=0

# mlockall(MCL_FUTURE) keeps locking pages for the life of the process, but CAP_IPC_LOCK --
# which lets it exceed this limit -- is surrendered at the privilege drop seconds later. Every
# allocation after that point is bounded by this rlimit, so systemd's 8 MiB default would
# surface as allocation failures during normal request handling, not just at startup.
#
# 128 MiB rather than infinity, because the requirement is bounded and measured. The daemon
# locks ~25 MiB at rest, and a store of 1000 secrets holding ~2000 versions peaks at ~27 MiB
# through a full write, read, rekey and audit-verify cycle -- the data is negligible next to
# the runtime baseline. The daemon refuses to start below 64 MiB, and this grants double that
# so ordinary growth does not turn into a failed start.
#
# Raise it with a drop-in if you store far more, or much larger values:
#   systemctl edit secretbaed   ->   [Service] / LimitMEMLOCK=256M
LimitMEMLOCK=128M

# Network sandboxing:
# RestrictAddressFamilies=AF_UNIX restricts the daemon strictly to local Unix domain sockets.
# Why RestrictAddressFamilies matters specifically for secretbae:
# secretbae is designed strictly as a local-only single-node secret manager that listens
# exclusively on the Unix domain socket /run/secretbae/sock. It never opens TCP or UDP
# sockets and has no legitimate need for network communication. Enforcing AF_UNIX at the
# kernel level guarantees that even if an attacker achieved arbitrary code execution within
# the daemon process, they could not open an outbound network socket to exfiltrate keys
# or open an unauthorized remote network listener.
RestrictAddressFamilies=AF_UNIX

# Default creation mask: directories 0700, files 0600
UMask=0077

# Runtime socket directory lifecycle: creates /run/secretbae owned by root, adjusted on startup
RuntimeDirectory=secretbae
RuntimeDirectoryMode=0750

# Service lifecycle
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
